{
  "name": "cardapio-cia-v3",
  "version": "3.0.0",
  "description": "Cardápio Cia v3.0 — Gerenciamento de receitas e cardápios semanais · Companhia do Churrasco",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/server.ts",
    "dev": "tsx --watch src/server.ts",
    "build:server": "npm run build && node scripts/build-exe.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:release": "npm run build:server && npm run build:electron"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "multer": "^1.4.5-lts.2",
    "pdfjs-dist": "^5.5.207",
    "pdfkit": "^0.18.0",
    "pngjs": "^7.0.0",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.17.5",
    "@types/pngjs": "^6.0.5",
    "@yao-pkg/pkg": "^6.19.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.4",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "pkg": {
    "assets": [
      "node_modules/better-sqlite3/build/Release/*.node",
      "node_modules/better-sqlite3/lib/**/*",
      "node_modules/pdfjs-dist/legacy/build/**/*"
    ]
  }
}
